local function IsAlly(plr)
   local myTeam, theirTeam = LocalPlayer.Team, plr.Team
   if myTeam and theirTeam and myTeam == theirTeam and myTeam.Name == "Marines" then
      return true
   end
   local char = plr.Character
   if char and char:FindFirstChildOfClass("ForceField") then
      return true
   end
   return false
end

local function GetNearestTarget()
   local now = os.clock()
   if soruLock and now < soruLockUntil then
      local lockChar = soruLock.Parent
      local lockHum = lockChar and lockChar:FindFirstChildOfClass("Humanoid")
      if lockHum and lockHum.Health > 0 then
         return soruLock
      end
      soruLock = nil
   end
   if cachedAt > 0 and now - cachedAt < TargetCacheTime and (not cachedTarget or cachedTarget.Parent) then
      return cachedTarget
   end
   local char = LocalPlayer.Character
   local hrp = char and char:FindFirstChild("HumanoidRootPart")
   if not hrp then return nil end
   local best, bestDist = nil, math.huge
   for _, plr in ipairs(Players:GetPlayers()) do
      if plr ~= LocalPlayer and plr.Character and not IsAlly(plr) then
         local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
         local hum = plr.Character:FindFirstChildOfClass("Humanoid")
         if targetHrp and hum and hum.Health > 0 then
            local dist = (targetHrp.Position - hrp.Position).Magnitude
            if dist < bestDist then
               best, bestDist = targetHrp, dist
            end
         end
      end
   end
   cachedTarget = best
   cachedAt = now
   return best
end

local aimMouse = LocalPlayer:GetMouse()
local oldMouseIndex

local function InstallMouseHook()
   if oldMouseIndex or not hookmetamethod then return end
   oldMouseIndex = hookmetamethod(game, "__index", newcc(function(self, key)
      if self == aimMouse and os.clock() < aimUntil and (key == "Hit" or key == "Target" or key == "UnitRay") and not checkcaller() then
         local target = GetNearestTarget()
         if target then
            if key == "Hit" then
               return CFrame.new(target.Position)
            end
            if key == "UnitRay" then
               local ray = oldMouseIndex(self, "UnitRay")
               return Ray.new(ray.Origin, (target.Position - ray.Origin).Unit)
            end
            return target
         end
      end
      return oldMouseIndex(self, key)
   end))
end

ContextActionService:BindActionAtPriority("VextomAimTrack", function(_, state, input)
   if state == Enum.UserInputState.Begin and Config.AimAssistEnabled then
      for _, rule in ipairs(aimRules) do
         if input.KeyCode == rule.key then
            local tool = GetEquippedToolByName(rule.tool)
            if tool then
               InstallMouseHook()
               aimTool = tool
               cachedAt = 0
               aimUntil = os.clock() + AimDuration
            end
            break
         end
      end
   end
   return Enum.ContextActionResult.Pass
end, false, Enum.ContextActionPriority.High.Value + 999, Enum.KeyCode.Z, Enum.KeyCode.X)

local SoruKey = Enum.KeyCode.R
local SoruRange = 150

ContextActionService:BindActionAtPriority("VextomSoruAim", function(_, state)
   if state == Enum.UserInputState.Begin and Config.SoruEnabled then
      local char = LocalPlayer.Character
      local hrp = char and char:FindFirstChild("HumanoidRootPart")
      cachedAt = 0
      local target = hrp and GetNearestTarget()
      if target and (target.Position - hrp.Position).Magnitude <= SoruRange then
         InstallMouseHook()
         aimUntil = math.max(aimUntil, os.clock() + SoruAimDuration)
         soruLock = target
         soruLockUntil = os.clock() + SoruAimDuration
      end
   end
   return Enum.ContextActionResult.Pass
end, false, Enum.ContextActionPriority.High.Value + 1001, SoruKey)

local oldNamecall
if hookmetamethod and getnamecallmethod then
   oldNamecall = hookmetamethod(game, "__namecall", newcc(function(self, ...)
      local method = getnamecallmethod()

      if method == "Emit" and Config.OptimizationEnabled and not checkcaller() then
         local count = ...
         if type(count) == "number" and count > 1 then
            return oldNamecall(self, math.max(1, math.floor(count * EffectRateScale)))
         end
      end

      if method ~= "FireServer" then
         return oldNamecall(self, ...)
      end

      local name = self.Name
      local first = ...

      local soruArgs, soruCount
      if name == "CommE" and first == "Soru" and Config.SoruEnabled then
         local soruTarget = GetNearestTarget()
         if soruTarget and os.clock() < aimUntil then
            local second = select(2, ...)
            if typeof(second) == "Vector3" then
               soruArgs = {...}
               soruArgs[2] = soruTarget.Position
               soruCount = select("#", ...)
            end
         end
         local skillKey = ParseKey(tostring(Config.SoruSkill))
         if not soruBusy and skillKey and skillKey ~= SoruKey then
            soruBusy = true
            setnamecallmethod(method)
            task.spawn(function()
               pcall(function()
                  ElevateThread()
                  local tool, justEquipped = EquipWeapon(Config.SoruItem)
                  if justEquipped or tool then
                     task.wait(0.05)
                  end
                  task.wait(0)
                  CastSkill(Config.SoruSkill, Config.SoruHold)
               end)
               task.wait(0.25)
               soruBusy = false
            end)
         end
         if soruArgs then
            return oldNamecall(self, table.unpack(soruArgs, 1, soruCount))
         end
      end

      if aimTool and os.clock() < aimUntil and self.Parent == aimTool and typeof(first) == "Vector3" then
         local target = GetNearestTarget()
         if target then
            local count = select("#", ...)
            local args = {...}
            args[1] = target.Position
            setnamecallmethod(method)
            return oldNamecall(self, table.unpack(args, 1, count))
         end
      end

      return oldNamecall(self, ...)
   end))
end

