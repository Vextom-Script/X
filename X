local function CheckToolTip(tool, wType)
   if not tool or not tool:IsA("Tool") then return false end
   local tt = tool.ToolTip
   return (wType == "Melee" and tt == "Melee") or (wType == "Blox Fruit" and (tt == "Blox Fruit" or string.find(tool.Name, "Fruit"))) or (wType == "Sword" and tt == "Sword") or (wType == "Gun" and tt == "Gun")
end

local function GetEquippedToolByName(kw)
   local char = LocalPlayer.Character
   if not char then return nil end
   local eq = char:FindFirstChildOfClass("Tool")
   if eq and string.find(string.lower(eq.Name), string.lower(kw)) then
      return eq
   end
   return nil
end

local GunKeywords = {"guitar", "bow", "kabucha"}

local GunCooldowns = {
