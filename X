local defaultConfig = "Soru = False, X, 0, Blox Fruit\nGun Bug = False, 0.6, 700\nSuper Jump = False, G\nAim Assist = False\nOptimization = False"

local function Trim(s)
   return s:match("^%s*(.-)%s*$")
end

local function ParseKey(str)
   if not str then return nil end
   local ok, key = pcall(function()
      return Enum.KeyCode[Trim(str):upper()]
   end)
   return ok and key or nil
end

local function SplitParts(content)
   local parts = {}
   for p in (content .. ","):gmatch("([^,]*),") do
      parts[#parts + 1] = Trim(p)
   end
   return parts
end

local function ReadTxtConfigs()
   pcall(function()
      if not isfolder(ConfigFolder) and makefolder then makefolder(ConfigFolder) end
      if not isfile(ConfigFile) and writefile then writefile(ConfigFile, defaultConfig) end
      if isfile(ConfigFile) and readfile then
         local text = readfile(ConfigFile)
         if text == lastConfigText then return end
         lastConfigText = text
         for line in text:gmatch("[^\r\n]+") do
            local name, content = line:match("^([^=]+)=%s*(.-)%s*$")
            if name and content then
               name = Trim(name)
               local parts = SplitParts(content)
               local isEn = (parts[1] or ""):lower() == "true"

               if name == "Soru" then
                  Config.SoruEnabled = isEn
                  if parts[2] and parts[2] ~= "" then Config.SoruSkill = parts[2] end
                  local hold = tonumber(parts[3])
                  if hold and hold >= 0 then Config.SoruHold = math.min(hold, MaxHold) end
                  if parts[4] and parts[4] ~= "" then Config.SoruItem = parts[4] end
               elseif name == "Gun Bug" then
                  Config.GunBugEnabled = isEn
                  local stop = tonumber(parts[2])
                  local power = tonumber(parts[3])
                  if stop and stop >= 0 then Config.GunBugStop = math.min(stop, MaxStop) end
                  if power and power > 0 then Config.GunBugPower = math.min(power, MaxPower) end
               elseif name == "Super Jump" then
                  Config.SuperJumpEnabled = isEn
                  local key = ParseKey(parts[2])
                  if key and AllowedJumpKeys[key] then Config.SuperJumpKey = key end
               elseif name == "Aim Assist" then Config.AimAssistEnabled = isEn
               elseif name == "Optimization" then Config.OptimizationEnabled = isEn
               end
            end
         end
      end
   end)
end

ReadTxtConfigs()
