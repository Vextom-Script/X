end)

local processedEffects = setmetatable({}, {__mode = "k"})
local SmoothPlastic = Enum.Material.SmoothPlastic
local PassChunk = 150
local EffectRateScale = 0.35
local optimizationApplied = false

local KeepMaterials = {
   [Enum.Material.Neon] = true,
   [Enum.Material.ForceField] = true,
   [Enum.Material.Glass] = true,
}

local function DegradeEffect(obj, class)
   if processedEffects[obj] then return end
   processedEffects[obj] = true
   if class == "ParticleEmitter" then
      if obj.Rate > 1 then
         obj.Rate = obj.Rate * EffectRateScale
      end
      obj.LightEmission = 0
   elseif class == "Beam" then
      obj.Texture = ""
      obj.Segments = math.min(obj.Segments, 2)
   else
      obj.Texture = ""
      obj.MinLength = math.max(obj.MinLength, 2)
   end
end

local function Optimize(obj)
   local class = obj.ClassName
   if class == "ParticleEmitter" or class == "Beam" or class == "Trail" then
      DegradeEffect(obj, class)
   elseif obj:IsA("BasePart") then
      if class ~= "Terrain" then
         if obj.CastShadow then
            obj.CastShadow = false
         end
         if obj.Material ~= SmoothPlastic and not KeepMaterials[obj.Material] then
            obj.Material = SmoothPlastic
         end
         if obj.MaterialVariant ~= "" then
            obj.MaterialVariant = ""
         end
      end
   end
end

Workspace.DescendantAdded:Connect(function(obj)
