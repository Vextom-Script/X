local function CastSkill(keyStr, hold)
   ElevateThread()
   local ok, k = pcall(function()
      return Enum.KeyCode[tostring(keyStr):upper()]
   end)
   if not ok or not k then return end
   VirtualInputManager:SendKeyEvent(true, k, false, game)
   task.wait(hold and hold > 0 and hold or 0.01)
   VirtualInputManager:SendKeyEvent(false, k, false, game)
end

local function EquipWeapon(weaponType)
   local char = LocalPlayer.Character
   if not char then return nil, false end
   local humanoid = char:FindFirstChildOfClass("Humanoid")
   if not humanoid then return nil, false end

   local equipped = char:FindFirstChildOfClass("Tool")
   if equipped and CheckToolTip(equipped, weaponType) then
      return equipped, false
   end

   local backpack = LocalPlayer:FindFirstChild("Backpack")
   if backpack then
      for _, tool in ipairs(backpack:GetChildren()) do
         if tool:IsA("Tool") and CheckToolTip(tool, weaponType) then
            humanoid:EquipTool(tool)
            return tool, true
         end
      end
   end
   return char:FindFirstChildOfClass("Tool"), false
end

local function GetMouseDirection()
   local char = LocalPlayer.Character
   local hrp = char and char:FindFirstChild("HumanoidRootPart")
   if not hrp then return Vector3.new(0, 0, 1) end
   local mouse = LocalPlayer:GetMouse()
   if mouse and mouse.Hit then
      local dir = (mouse.Hit.Position - hrp.Position)
      if dir.Magnitude > 0.001 then return dir.Unit end
   end
   return hrp.CFrame.LookVector
end

local BoostMaxTime = 3

local activeBoosts = {}
local boostTokens = {}
local activeSequences = {}
local stopTokens = {}

local boostTools = {
   ["Gun Bug"] = GunKeywords,
}

local function RemoveBoost(name)
   local boost = activeBoosts[name]
   if boost then
      pcall(function()
         boost.lv:Destroy()
         boost.att:Destroy()
      end)
      activeBoosts[name] = nil
   end
end

local function StopBoost(name)
   boostTokens[name] = (boostTokens[name] or 0) + 1
   RemoveBoost(name)
end

local function StopAllBoosts()
   for name in pairs(boostTools) do
      StopBoost(name)
   end
end

local function BindCharacter(char)
   local humanoid = char:WaitForChild("Humanoid", 10)
   if humanoid then
      humanoid.Died:Connect(StopAllBoosts)
   end
   char.ChildRemoved:Connect(function(child)
      if child:IsA("Tool") then
         local toolName = string.lower(child.Name)
         for name, keywords in pairs(boostTools) do
            for _, kw in ipairs(keywords) do
               if string.find(toolName, kw, 1, true) then
                  StopBoost(name)
                  break
               end
            end
         end
      end
   end)
end

