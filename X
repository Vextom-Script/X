local function HaltCharacter(name, token)
   local elapsed = 0
   while elapsed < 0.15 do
      if boostTokens[name] ~= token or next(activeBoosts) then return end
      local char = LocalPlayer.Character
      local hrp = char and char:FindFirstChild("HumanoidRootPart")
      if not hrp then return end
      hrp.AssemblyLinearVelocity = Vector3.zero
      hrp.AssemblyAngularVelocity = Vector3.zero
      elapsed = elapsed + task.wait()
   end
end

local function ScheduleStop(name, stopTime)
   stopTokens[name] = (stopTokens[name] or 0) + 1
   if not stopTime or stopTime <= 0 then return end
   local token = stopTokens[name]
   task.delay(stopTime, function()
      if stopTokens[name] ~= token then return end
      StopBoost(name)
      HaltCharacter(name, boostTokens[name])
   end)
end

local function GetLifetime(stopTime)
   return math.max(BoostMaxTime, (stopTime or 0) + 1)
end

local function StartBoost(name, dir, power, lifetime)
   RemoveBoost(name)
   local char = LocalPlayer.Character
   local hrp = char and char:FindFirstChild("HumanoidRootPart")
   if not hrp then return end
   local att = Instance.new("Attachment")
   att.Parent = hrp
   local lv = Instance.new("LinearVelocity")
   lv.Attachment0 = att
   lv.MaxForce = 1e6
   lv.VectorVelocity = dir * power
   lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
   lv.Parent = hrp
   local boost = {lv = lv, att = att}
   activeBoosts[name] = boost
   task.delay(lifetime or BoostMaxTime, function()
      if activeBoosts[name] == boost then
         RemoveBoost(name)
      end
   end)
end

local function GunDash(power, stopTime)
   local name = "Gun Bug"
   boostTokens[name] = (boostTokens[name] or 0) + 1
   local token = boostTokens[name]
   ScheduleStop(name, stopTime)
   StartBoost(name, GetMouseDirection(), power, GetLifetime(stopTime))
   task.wait(0.2)
   if boostTokens[name] == token then
      RemoveBoost(name)
   end
end

